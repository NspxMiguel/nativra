<!-- Single source for colour, radius and type. Nothing below this file hardcodes
     a hex value: when the accent changes, it changes here and nowhere else. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surface. True black, because an OLED TV switches those pixels off and
         the grid appears to float on the panel itself. -->
    <Color x:Key="BackgroundColor">#000000</Color>
    <Color x:Key="SurfaceColor">#101013</Color>
    <SolidColorBrush x:Key="Background" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />

    <!-- One accent. Not one per tile — the app art carries each app's identity,
         so a second palette would only add noise. -->
    <Color x:Key="AccentColor">#2BE08C</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />

    <!-- Text, at the four weights the screen actually uses. -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F5F5F7" />
    <SolidColorBrush x:Key="TextSecondary" Color="#99F5F5F7" />
    <SolidColorBrush x:Key="TextTertiary" Color="#66F5F5F7" />

    <!-- Depth comes from a hairline and a near-invisible sheen, never a shadow. -->
    <SolidColorBrush x:Key="Hairline" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="HairlineStrong" Color="#33FFFFFF" />
    <LinearGradientBrush x:Key="Sheen" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0BFFFFFF" Offset="0" />
        <GradientStop Color="#02FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Tile" Color="#161A1F" />

    <CornerRadius x:Key="CardRadius">22</CornerRadius>
    <CornerRadius x:Key="IconRadius">14</CornerRadius>

    <!-- Type scale for a 10-foot screen: everything is a step larger than it
         would be on a desk, because the viewer is across the room. -->
    <x:Double x:Key="TitleSize">46</x:Double>
    <x:Double x:Key="LabelSize">14</x:Double>
    <x:Double x:Key="TileTitleSize">23</x:Double>
    <x:Double x:Key="TileSubtitleSize">16</x:Double>
    <x:Double x:Key="StatusSize">17</x:Double>
    <!-- The system paints selection purple; a console front end should not
         borrow a colour it never chose. -->
    <Style x:Key="RowStyle" TargetType="ListViewItem">
        <Setter Property="Padding" Value="10,6,10,6" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Fill" CornerRadius="6" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver" />
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="#26FFFFFF" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource AccentColor}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
