<Page
    x:Class="Kiosk.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kiosk"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource Background}">

    <Grid>
        <!-- The game's own art fills the screen, the way its store page does. -->
        <Image x:Name="HeroImage" Stretch="UniformToFill" Opacity="0.55"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#00000000" Offset="0" />
                    <GradientStop Color="#CC000000" Offset="0.55" />
                    <GradientStop Color="#FF000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Padding="28,0,28,14" Spacing="10">
                <TextBlock x:Name="TitleText" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"
                           TextTrimming="CharacterEllipsis" MaxLines="1" />

                <StackPanel Orientation="Horizontal" Spacing="26">
                    <Button x:Name="InstallButton" Click="OnInstall"
                            Background="{StaticResource Accent}" Foreground="#FF06120C"
                            FontSize="14" FontWeight="SemiBold" Padding="22,7,22,8"
                            CornerRadius="6" BorderThickness="0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PlayedLabel" FontSize="10"
                                   Foreground="{StaticResource TextTertiary}" />
                        <TextBlock x:Name="PlayedText" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="StateLabel" FontSize="10"
                                   Foreground="{StaticResource TextTertiary}" />
                        <TextBlock x:Name="StateText" FontSize="14"
                                   Foreground="{StaticResource TextPrimary}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="StatusText" FontSize="12" Margin="0,4,0,0"
                           TextWrapping="Wrap" MaxLines="2"
                           Foreground="{StaticResource TextSecondary}" />
            </StackPanel>

            <Grid Grid.Row="2" Height="40" Padding="28,0,28,0"
                  BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="19" Height="19" CornerRadius="999" Background="#FFE05B5B">
                            <TextBlock Text="B" FontSize="10" FontWeight="Bold" Foreground="#FF1A0505"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="HintBackText" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Install: how big it is and where it goes, before anything downloads -->
        <Grid x:Name="InstallSheet" Visibility="Collapsed" Background="#E6000000">
            <Border Width="420" CornerRadius="12" Padding="22"
                    Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource HairlineStrong}" BorderThickness="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock x:Name="SheetTitle" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock x:Name="SheetName" FontSize="13" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" MaxLines="1" Width="250" />
                        <TextBlock x:Name="SheetSize" FontSize="13" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource TextSecondary}" />
                    </StackPanel>

                    <TextBlock x:Name="SheetWhereLabel" FontSize="10"
                               Foreground="{StaticResource TextTertiary}" />
                    <ListView x:Name="PlaceList" SelectionMode="Single" MaxHeight="120">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:InstallPlace">
                                <Grid>
                                    <TextBlock Text="{x:Bind Name}" FontSize="13"
                                               Foreground="{StaticResource TextPrimary}" />
                                    <TextBlock Text="{x:Bind Free}" FontSize="12"
                                               HorizontalAlignment="Right"
                                               Foreground="{StaticResource TextSecondary}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button x:Name="SheetOk" Click="OnConfirmInstall"
                                Background="{StaticResource Accent}" Foreground="#FF06120C"
                                FontSize="13" Padding="18,6,18,7" CornerRadius="6"
                                BorderThickness="0" />
                        <Button x:Name="SheetCancel" Click="OnCancelInstall"
                                Background="#22FFFFFF" Foreground="{StaticResource TextPrimary}"
                                FontSize="13" Padding="18,6,18,7" CornerRadius="6"
                                BorderThickness="0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Something went wrong: the whole screen says so, not a line of text -->
        <Grid x:Name="ErrorScreen" Visibility="Collapsed" Background="#F2000000">
            <StackPanel VerticalAlignment="Center" Padding="56,0,56,0" Spacing="12">
                <TextBlock x:Name="ErrorTitle" FontSize="30" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorBody" FontSize="14" TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondary}" />
                <TextBlock x:Name="ErrorHint" FontSize="12" Margin="0,10,0,0"
                           Foreground="{StaticResource TextTertiary}" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
