<!-- The design's tokens, and the only place they are written down.
     Nothing below this file states a hex value, a radius or a type size: the
     handoff calls these the source of truth, so they live in one file and
     every screen refers to them by name.

     The scale is fixed at 1920x1080 and the shell scales the whole canvas to
     whatever the television is, so every number here is in design pixels and
     never needs a second set for another resolution. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================ surface -->

    <Color x:Key="ScreenColor">#FF0D1012</Color>
    <Color x:Key="SurfaceColor">#FF14181A</Color>
    <Color x:Key="Surface2Color">#FF171B1D</Color>
    <Color x:Key="Surface3Color">#FF1B2124</Color>
    <Color x:Key="DockColor">#FF101314</Color>
    <Color x:Key="DockEdgeColor">#FF1A1F22</Color>
    <Color x:Key="TrackColor">#FF1F2527</Color>

    <SolidColorBrush x:Key="Screen" Color="{StaticResource ScreenColor}" />
    <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
    <SolidColorBrush x:Key="Surface3" Color="{StaticResource Surface3Color}" />
    <SolidColorBrush x:Key="Dock" Color="{StaticResource DockColor}" />
    <SolidColorBrush x:Key="DockEdge" Color="{StaticResource DockEdgeColor}" />
    <SolidColorBrush x:Key="Track" Color="{StaticResource TrackColor}" />

    <!-- The screen's glow: one soft ellipse, high and to the right, and what
         keeps a very dark panel from reading as switched off.

         It is an image rather than a brush because this platform's XAML has
         no radial gradient, and the version that adds one is above the
         minimum this app supports. The image is generated from the same
         numbers the handoff gives, so it is exact rather than approximated,
         and it costs nothing to draw. -->
    <ImageBrush x:Key="ScreenGlow" Stretch="Fill"
                ImageSource="ms-appx:///Assets/screen-glow.png" />

    <!-- ============================================================== accent -->

    <!-- One accent, used for focus, for success and for anything the person can
         act on. A second would only compete with the box art. -->
    <Color x:Key="AccentColor">#FF3EFFC0</Color>
    <Color x:Key="OnAccentColor">#FF0D1012</Color>
    <SolidColorBrush x:Key="Accent" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="OnAccent" Color="{StaticResource OnAccentColor}" />
    <SolidColorBrush x:Key="AccentDim" Color="#1F3EFFC0" />
    <SolidColorBrush x:Key="AccentEdge" Color="#FF2D6B57" />

    <SolidColorBrush x:Key="Warning" Color="#FFFF9B4A" />
    <SolidColorBrush x:Key="WarningText" Color="#FFFFC77A" />
    <SolidColorBrush x:Key="WarningEdge" Color="#FF5C4A20" />
    <SolidColorBrush x:Key="Danger" Color="#FFFF5C5C" />
    <SolidColorBrush x:Key="DangerText" Color="#FFFF8080" />
    <SolidColorBrush x:Key="Favourite" Color="#FFFFD24A" />
    <SolidColorBrush x:Key="Installing" Color="#FF7CC4FF" />

    <!-- ================================================================ text -->

    <SolidColorBrush x:Key="TextPrimary" Color="#FFF2F5F4" />
    <SolidColorBrush x:Key="TextSecondary" Color="#FFD8DEDC" />
    <SolidColorBrush x:Key="TextTertiary" Color="#FF9AA5A3" />
    <SolidColorBrush x:Key="TextMuted" Color="#FF6B7573" />
    <SolidColorBrush x:Key="TextFaint" Color="#FF5C6663" />
    <SolidColorBrush x:Key="TextDevNotice" Color="#FF4A5254" />

    <!-- Empty slots and placeholders, which are deliberately barely there. -->
    <SolidColorBrush x:Key="Placeholder" Color="#FF2C3336" />
    <SolidColorBrush x:Key="PlaceholderEdge" Color="#FF232A2C" />

    <!-- ================================================================ type -->

    <!-- One family throughout. Archivo is the design's choice; the console may
         not carry it, so the fallbacks are named here rather than left to
         whatever the platform picks. -->
    <x:String x:Key="FontFamilyName">Archivo, Segoe UI Variable Display, Segoe UI</x:String>

    <!-- The scale, measured so the smallest text is still legible three metres
         from the screen. Nothing on a television may be smaller than 22. -->
    <x:Double x:Key="DisplaySize">60</x:Double>
    <x:Double x:Key="GameTitleSize">64</x:Double>
    <x:Double x:Key="ModalTitleSize">46</x:Double>
    <x:Double x:Key="SectionSize">34</x:Double>
    <x:Double x:Key="CtaSize">30</x:Double>
    <x:Double x:Key="ItemNameSize">28</x:Double>
    <x:Double x:Key="ItemNameSmallSize">26</x:Double>
    <x:Double x:Key="BodySize">24</x:Double>
    <x:Double x:Key="LabelSize">22</x:Double>
    <x:Double x:Key="DevNoticeSize">18</x:Double>

    <!-- ====================================================== shape and space -->

    <x:Double x:Key="SafeArea">56</x:Double>
    <x:Double x:Key="StatusBarHeight">76</x:Double>
    <x:Double x:Key="DockHeight">150</x:Double>

    <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
    <CornerRadius x:Key="RadiusButton">12</CornerRadius>
    <CornerRadius x:Key="RadiusJob">14</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>
    <CornerRadius x:Key="RadiusSlot">18</CornerRadius>
    <CornerRadius x:Key="RadiusModal">24</CornerRadius>
    <CornerRadius x:Key="RadiusPill">999</CornerRadius>

    <!-- =========================================================== box art -->

    <!-- Placeholders only: real art comes from the store. These stay as the
         fallback for the moment before it has loaded, so a shelf never shows
         a row of empty rectangles. Cycled by game id. -->
    <LinearGradientBrush x:Key="Art0" StartPoint="0,0" EndPoint="0.94,1">
        <GradientStop Color="#FF123B33" Offset="0" />
        <GradientStop Color="#FF1E5C4C" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Art1" StartPoint="0,0" EndPoint="0.94,1">
        <GradientStop Color="#FF2A2140" Offset="0" />
        <GradientStop Color="#FF4A3470" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Art2" StartPoint="0,0" EndPoint="0.94,1">
        <GradientStop Color="#FF3A1F22" Offset="0" />
        <GradientStop Color="#FF6B2E36" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Art3" StartPoint="0,0" EndPoint="0.94,1">
        <GradientStop Color="#FF1E2A44" Offset="0" />
        <GradientStop Color="#FF31507A" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Art4" StartPoint="0,0" EndPoint="0.94,1">
        <GradientStop Color="#FF3A2E14" Offset="0" />
        <GradientStop Color="#FF6B5220" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Art5" StartPoint="0,0" EndPoint="0.94,1">
        <GradientStop Color="#FF173028" Offset="0" />
        <GradientStop Color="#FF245C46" Offset="1" />
    </LinearGradientBrush>

    <!-- The avatar, which is the only other gradient in the interface. -->
    <LinearGradientBrush x:Key="AvatarFill" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF3EFFC0" Offset="0" />
        <GradientStop Color="#FF1C8F6C" Offset="1" />
    </LinearGradientBrush>

    <!-- ============================================================ movement -->

    <!-- The handoff gives two cubic-bezier curves. This platform's XAML has no
         arbitrary bezier easing, so each is matched with the nearest curve it
         does have: both of the originals are steep ease-outs that arrive
         almost immediately and settle, which is what an exponential ease-out
         describes. The exponents were chosen to sit on the original curves
         rather than merely to look similar.

         Naming them here is what keeps every screen moving at one speed. -->
    <ExponentialEase x:Key="Settle" EasingMode="EaseOut" Exponent="5" />
    <ExponentialEase x:Key="Wipe" EasingMode="EaseOut" Exponent="4" />

    <!-- ============================================================== pieces -->

    <!-- A dock icon: circular, neutral until it is focused, and it rises rather
         than glows. Focus is the only thing that moves on this screen. -->
    <Style x:Key="DockIconStyle" TargetType="Button">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="Lift" />
                        </Grid.RenderTransform>
                        <Ellipse x:Name="Fill" Fill="{TemplateBinding Background}" />
                        <ContentPresenter x:Name="Glyph"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                            Storyboard.TargetProperty="Y" To="-6"
                                            Duration="0:0:0.18"
                                            EasingFunction="{StaticResource Settle}" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill"
                                            Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource Accent}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph"
                                            Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource OnAccent}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                            Storyboard.TargetProperty="Y" To="-6" Duration="0:0:0.09" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill"
                                            Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource Accent}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph"
                                            Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource OnAccent}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Lift"
                                            Storyboard.TargetProperty="Y" To="-6"
                                            Duration="0:0:0.18"
                                            EasingFunction="{StaticResource Settle}" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill"
                                            Storyboard.TargetProperty="Fill">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource Accent}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Glyph"
                                            Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource OnAccent}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A game tile. Focus grows it slightly and nothing else changes: the art
         is the content, so the frame around it should not compete. -->
    <Style x:Key="TileStyle" TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,1"
                          Background="Transparent">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Grow" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <ContentPresenter />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow"
                                            Storyboard.TargetProperty="ScaleX" To="1.035"
                                            Duration="0:0:0.13" EasingFunction="{StaticResource Settle}" />
                                        <DoubleAnimation Storyboard.TargetName="Grow"
                                            Storyboard.TargetProperty="ScaleY" To="1.035"
                                            Duration="0:0:0.13" EasingFunction="{StaticResource Settle}" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow"
                                            Storyboard.TargetProperty="ScaleX" To="1.035"
                                            Duration="0:0:0.13" EasingFunction="{StaticResource Settle}" />
                                        <DoubleAnimation Storyboard.TargetName="Grow"
                                            Storyboard.TargetProperty="ScaleY" To="1.035"
                                            Duration="0:0:0.13" EasingFunction="{StaticResource Settle}" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The accent call to action: Play, Install, Sign in. -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Accent}" />
        <Setter Property="Foreground" Value="{StaticResource OnAccent}" />
        <Setter Property="FontSize" Value="{StaticResource CtaSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Padding" Value="60,20,60,20" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Grow" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusButton}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow"
                                            Storyboard.TargetProperty="ScaleX" To="1.03"
                                            Duration="0:0:0.13" EasingFunction="{StaticResource Settle}" />
                                        <DoubleAnimation Storyboard.TargetName="Grow"
                                            Storyboard.TargetProperty="ScaleY" To="1.03"
                                            Duration="0:0:0.13" EasingFunction="{StaticResource Settle}" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Grow"
                                            Storyboard.TargetProperty="ScaleX" To="1.03"
                                            Duration="0:0:0.13" EasingFunction="{StaticResource Settle}" />
                                        <DoubleAnimation Storyboard.TargetName="Grow"
                                            Storyboard.TargetProperty="ScaleY" To="1.03"
                                            Duration="0:0:0.13" EasingFunction="{StaticResource Settle}" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A neutral chip: secondary actions, filters, tags. -->
    <Style x:Key="ChipStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Surface2}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="{StaticResource BodySize}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Padding" Value="26,12,26,12" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Fill" Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource RadiusPill}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource Surface3}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="Focused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Fill"
                                            Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                Value="{StaticResource AccentDim}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A circular icon button: back, filter. -->
    <Style x:Key="RoundButtonStyle" TargetType="Button" BasedOn="{StaticResource DockIconStyle}">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
    </Style>
</ResourceDictionary>
