<Page
    x:Class="Kiosk.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kiosk"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnKeyDown"
    Background="{StaticResource Background}">

    <Page.Resources>
        <!-- Focus is the whole interaction on a console: the tile lifts, the
             hairline turns to the accent, and the art brightens. 150ms with a
             real curve, so it answers the thumb rather than sliding. -->
        <Style x:Key="TileContainerStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,28,28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>

                            <!-- The one signature of this app: a soft pool of accent
                                 light behind the focused tile, as if the console lit
                                 it up. No drop shadow anywhere. -->
                            <Border x:Name="Glow"
                                    CornerRadius="{StaticResource CardRadius}"
                                    Background="{StaticResource Accent}"
                                    Opacity="0"
                                    Margin="-6" />

                            <Border x:Name="Card"
                                    CornerRadius="{StaticResource CardRadius}"
                                    Background="{StaticResource Surface}"
                                    BorderBrush="{StaticResource Hairline}"
                                    BorderThickness="1">
                                <Grid>
                                    <Border CornerRadius="{StaticResource CardRadius}"
                                            Background="{StaticResource Sheen}" />
                                    <ContentPresenter />
                                </Grid>
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.10" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.975" Duration="0:0:0.15" />
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.975" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.06" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.06" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Glow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.22" Duration="0:0:0.15" />
                                            <ObjectAnimationUsingKeyFrames
                                                Storyboard.TargetName="Card"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                    Value="{StaticResource Accent}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="TileTemplate" x:DataType="local:Tile">
            <Grid Width="300" Height="216" Padding="26">
                <StackPanel VerticalAlignment="Bottom">
                    <Grid Width="60" Height="60" HorizontalAlignment="Left" Margin="0,0,0,18">
                        <Border CornerRadius="{StaticResource IconRadius}"
                                Background="{StaticResource Accent}"
                                Visibility="{x:Bind InitialVisible}">
                            <TextBlock Text="{x:Bind Initial}" FontSize="28" FontWeight="SemiBold"
                                       Foreground="#FF000000" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border CornerRadius="{StaticResource IconRadius}"
                                Visibility="{x:Bind LogoVisible}">
                            <Image Source="{x:Bind Logo}" Stretch="UniformToFill" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{x:Bind Title}"
                               FontSize="{StaticResource TileTitleSize}" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Subtitle}"
                               FontSize="{StaticResource TileSubtitleSize}"
                               Foreground="{StaticResource TextSecondary}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- 5% of the frame stays empty on every side: the TV-safe area, which is
         also what stops the grid from feeling crammed. -->
    <Grid Padding="96,64,96,56">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,44">
            <TextBlock x:Name="EyebrowText"
                       FontSize="{StaticResource LabelSize}" FontWeight="Bold"
                       Foreground="{StaticResource Accent}" CharacterSpacing="220" />
            <TextBlock x:Name="TitleText"
                       FontSize="{StaticResource TitleSize}" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0" />
        </StackPanel>

        <GridView x:Name="AppGrid" Grid.Row="1"
                  ItemsSource="{x:Bind Tiles}"
                  ItemTemplate="{StaticResource TileTemplate}"
                  ItemContainerStyle="{StaticResource TileContainerStyle}"
                  IsItemClickEnabled="True"
                  ItemClick="OnTileInvoked"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  Padding="6,6,6,28" />

        <!-- Empty state and status share this line: it says what to do next,
             never only what is missing. -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="14">
            <Border Width="9" Height="9" CornerRadius="999"
                    Background="{StaticResource Accent}" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" FontSize="{StaticResource StatusSize}"
                       Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
