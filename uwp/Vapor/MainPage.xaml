<Page
    x:Class="Vapor.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF0B0E12">
    <Grid Padding="56,40,56,40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="340" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,40,0">
            <TextBlock Text="STEAM" FontSize="12" FontWeight="Bold"
                       Foreground="#FF66C0F4" CharacterSpacing="240" />
            <TextBlock x:Name="Title" FontSize="34" FontWeight="Bold"
                       Foreground="#FFF5F5F7" Margin="0,8,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="Subtitle" FontSize="17" Foreground="#99F5F5F7"
                       Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="25" />
            <TextBlock x:Name="Status" FontSize="15" Foreground="#66F5F5F7"
                       Margin="0,18,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Column="1" x:Name="QrFrame" CornerRadius="20" Background="White"
                Padding="14" VerticalAlignment="Center"
                Width="300" Height="300">
            <Image x:Name="QrImage" Stretch="Uniform" />
        </Border>
    </Grid>
</Page>
