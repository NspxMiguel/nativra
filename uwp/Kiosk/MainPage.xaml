<Page
    x:Class="Kiosk.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kiosk"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnKeyDown"
    Background="{StaticResource Background}">

    <Page.Resources>
        <!-- A console home screen moves one thing: the focused icon. It grows
             and takes a bright ring; everything else holds still. -->
        <Style x:Key="RailItemStyle" TargetType="ListViewItem">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Grid x:Name="Root" Width="104" Height="104">
                            <Grid x:Name="Box" Width="76" Height="76"
                                  RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                                </Grid.RenderTransform>
                                <Border x:Name="Ring"
                                        CornerRadius="12"
                                        Background="{StaticResource Tile}"
                                        BorderBrush="{StaticResource Hairline}"
                                        BorderThickness="2" />
                                <Border CornerRadius="12" Margin="2">
                                    <ContentPresenter />
                                </Border>
                            </Grid>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleX" To="1.24" Duration="0:0:0.09" />
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleY" To="1.24" Duration="0:0:0.09" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleX" To="1.30" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleY" To="1.30" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ring"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RailTemplate" x:DataType="local:Tile">
            <Border CornerRadius="10" Background="{x:Bind Accent}" Opacity="{x:Bind Dimmed}">
                <TextBlock Text="{x:Bind Initial}" FontSize="26" FontWeight="Bold"
                           Foreground="#FF06120C"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- system bar -->
        <Grid Grid.Row="0" Padding="28,14,28,0" Height="40">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10">
                <Border Width="22" Height="22" CornerRadius="999">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
                            <GradientStop Color="#FF1E8F55" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="MachineText" FontSize="12"
                           Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="14">
                <TextBlock x:Name="CountText" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" />
                <TextBlock x:Name="ClockText" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- the rail, and the focused item's name above it -->
        <Grid Grid.Row="1" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Padding="28,0,28,0" Margin="0,0,0,12">
                <TextBlock x:Name="NameText" FontSize="24" FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="SubText" FontSize="13" Margin="0,4,0,0"
                           TextTrimming="CharacterEllipsis" MaxLines="1"
                           Foreground="{StaticResource TextSecondary}" />
            </StackPanel>

            <ListView x:Name="AppRail" Grid.Row="1"
                      ItemsSource="{x:Bind Tiles}"
                      ItemTemplate="{StaticResource RailTemplate}"
                      ItemContainerStyle="{StaticResource RailItemStyle}"
                      IsItemClickEnabled="True"
                      ItemClick="OnTileInvoked"
                      SelectionChanged="OnSelectionChanged"
                      SelectionMode="Single"
                      Padding="28,0,28,0"
                      ScrollViewer.HorizontalScrollMode="Enabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                      ScrollViewer.VerticalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
            </ListView>
        </Grid>

        <!-- button hints: the most console thing on the screen -->
        <Grid Grid.Row="2" Height="44" Padding="28,0,28,0"
              BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Width="20" Height="20" CornerRadius="999" Background="{StaticResource Accent}">
                        <TextBlock Text="A" FontSize="11" FontWeight="Bold" Foreground="#FF06120C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="HintOpenText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Border Width="20" Height="20" CornerRadius="999" Background="#FFF2C94C">
                        <TextBlock Text="Y" FontSize="11" FontWeight="Bold" Foreground="#FF1A1405"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="HintRefreshText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}" />
        </Grid>
    </Grid>
</Page>
