<Page
    x:Class="Kiosk.SteamPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kiosk"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource Background}">

    <Page.Resources>
        <!-- Same grammar as the home rail: only the focused card moves. -->
        <Style x:Key="GameCardStyle" TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewItem">
                        <Grid x:Name="Root" Width="158" Height="96"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="Ring" CornerRadius="10"
                                    Background="{StaticResource Tile}"
                                    BorderBrush="{StaticResource Hairline}"
                                    BorderThickness="2">
                                <ContentPresenter />
                            </Border>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Unfocused" />
                                    <VisualState x:Name="Focused">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleX" To="1.08" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleY" To="1.08" Duration="0:0:0.14">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Ring"
                                                Storyboard.TargetProperty="BorderBrush">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="White" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="GameTemplate" x:DataType="local:OwnedGame">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" CornerRadius="8,8,0,0" Margin="2,2,2,0">
                    <Image Source="{x:Bind Art}" Stretch="UniformToFill" />
                </Border>
                <Grid Grid.Row="1" Margin="6,4,6,5">
                    <TextBlock Text="{x:Bind Name}" FontSize="11" Margin="0,0,14,0"
                               MaxLines="1" TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimary}" />
                    <!-- Whether this game has been seen running on a console. -->
                    <Ellipse Width="7" Height="7" HorizontalAlignment="Right"
                             VerticalAlignment="Center" Fill="{x:Bind BadgeBrush}" />
                </Grid>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="28,10,28,0" Height="46">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                <TextBlock x:Name="HeaderText" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}" />
                <Border x:Name="FilterChip" CornerRadius="999" Padding="8,2,8,3"
                        Background="#1AFFFFFF" VerticalAlignment="Center">
                    <TextBlock x:Name="FilterText" FontSize="11"
                               Foreground="{StaticResource TextSecondary}" />
                </Border>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Spacing="10">
                <!-- Focusing this on a console raises the on-screen keyboard. -->
                <TextBox x:Name="SearchBox" Width="180" Height="26" FontSize="12"
                         Visibility="Collapsed" TextChanged="OnSearchChanged"
                         PlaceholderText="" />
                <TextBlock x:Name="AccountText" FontSize="12"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondary}" />
            </StackPanel>
        </Grid>

        <!-- Sign in: the QR code and nothing else competing with it. -->
        <Grid x:Name="SignInPanel" Grid.Row="1" Padding="28,0,28,0"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="QrFrame" Grid.Column="0" Width="230" Height="230"
                    CornerRadius="12" Background="White" Padding="10">
                <Image x:Name="QrImage" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="SignInTitle" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" />
                <TextBlock x:Name="SignInHow" FontSize="13" Margin="0,8,0,0"
                           Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>

        <!-- Library -->
        <Grid x:Name="LibraryPanel" Grid.Row="1" Visibility="Collapsed">
            <GridView x:Name="GameGrid"
                      ItemsSource="{x:Bind Games}"
                      ItemTemplate="{StaticResource GameTemplate}"
                      ItemContainerStyle="{StaticResource GameCardStyle}"
                      IsItemClickEnabled="True"
                      ItemClick="OnGameInvoked"
                      SelectionMode="Single"
                      SelectionChanged="OnGameSelected"
                      Padding="28,6,28,6"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Hidden" />
        </Grid>

        <Grid Grid.Row="2" Height="44" Padding="28,0,28,0"
              BorderBrush="{StaticResource Hairline}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="20">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="20" Height="20" CornerRadius="999" Background="#FFE05B5B">
                        <TextBlock Text="B" FontSize="11" FontWeight="Bold" Foreground="#FF1A0505"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="HintBackText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border Width="20" Height="20" CornerRadius="999" Background="#FFF2C94C">
                        <TextBlock Text="Y" FontSize="11" FontWeight="Bold" Foreground="#FF1A1405"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="HintRefreshText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
                <StackPanel x:Name="SearchHint" Orientation="Horizontal" Spacing="8"
                            Visibility="Collapsed">
                    <Border Width="20" Height="20" CornerRadius="999" Background="#FF56A8F5">
                        <TextBlock Text="X" FontSize="11" FontWeight="Bold" Foreground="#FF04121C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="HintSearchText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
                <StackPanel x:Name="FilterHint" Orientation="Horizontal" Spacing="8"
                            Visibility="Collapsed">
                    <Border Width="34" Height="20" CornerRadius="999" Background="#33FFFFFF">
                        <TextBlock Text="LB RB" FontSize="9" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="HintFilterText" FontSize="12" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="StatusText" FontSize="12" HorizontalAlignment="Right"
                       VerticalAlignment="Center" Foreground="{StaticResource TextTertiary}" />
        </Grid>
    </Grid>
</Page>
