<Page
    x:Class="Vapor.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF0B0E12">
    <Grid Padding="96,56,96,56">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,72,0">
            <TextBlock Text="STEAM" FontSize="15" FontWeight="Bold"
                       Foreground="#FF66C0F4" CharacterSpacing="240" />
            <TextBlock x:Name="Title" FontSize="54" FontWeight="Bold"
                       Foreground="#FFF5F5F7" Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock x:Name="Subtitle" FontSize="24" Foreground="#99F5F5F7"
                       Margin="0,18,0,0" TextWrapping="Wrap" LineHeight="36" />
            <TextBlock x:Name="Status" FontSize="19" Foreground="#66F5F5F7"
                       Margin="0,28,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Column="1" x:Name="QrFrame" CornerRadius="20" Background="White"
                Padding="24" VerticalAlignment="Center"
                Width="460" Height="460">
            <Image x:Name="QrImage" Stretch="Uniform" />
        </Border>
    </Grid>
</Page>
