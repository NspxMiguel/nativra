<?xml version="1.0"?>
<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Kiosk" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" x:Class="Kiosk.MainPage" mc:Ignorable="d" KeyDown="OnKeyDown" FontFamily="{StaticResource FontFamilyName}" Background="{StaticResource Screen}">
  <!-- The whole interface is drawn at 1920x1080 and scaled to whatever the
         television is. Every size in here is a design pixel: one canvas, one
         set of numbers, and no second layout to keep in step with the first. -->
  <Page.Resources>
    <!-- One tile on the shelf. The art is the content; the frame around it
             does nothing but hold the corner radius. -->
    <DataTemplate x:Key="TileTemplate" x:DataType="local:Tile">
      <Button Style="{StaticResource TileStyle}" Click="OnTileClicked" GotFocus="OnTileFocused" LostFocus="OnTileUnfocused" Tag="{x:Bind}" Margin="12,28,24,20" Padding="0" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Bottom">
        <Button.RenderTransform>
          <ScaleTransform/>
        </Button.RenderTransform>
        <StackPanel>
          <Grid Width="{x:Bind TileWidth}" Height="{x:Bind TileHeight}" Opacity="{x:Bind Dimmed}">
            <!-- Box art, or the gradient standing in for it.
                             Drawn as a filled rectangle rather than a bordered
                             image: a border does not clip what it holds, so an
                             icon wider than the tile spills past the corner. -->
            <Rectangle RadiusX="12" RadiusY="12" Fill="{x:Bind Art}" Visibility="{x:Bind ArtShown}"/>
            <Rectangle RadiusX="12" RadiusY="12" Visibility="{x:Bind IconShown}">
              <Rectangle.Fill>
                <ImageBrush ImageSource="{x:Bind Icon}" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
              </Rectangle.Fill>
            </Rectangle>
            <!-- The tile that opens everything. -->
            <Border CornerRadius="{StaticResource RadiusButton}" Background="#FF151A1C" Visibility="{x:Bind AllGamesShown}">
              <Grid Width="46" Height="46" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Rectangle Grid.Row="0" Grid.Column="0" Margin="0,0,5,5" Fill="{StaticResource TextMuted}" RadiusX="3" RadiusY="3"/>
                <Rectangle Grid.Row="0" Grid.Column="1" Margin="5,0,0,5" Fill="{StaticResource TextMuted}" RadiusX="3" RadiusY="3"/>
                <Rectangle Grid.Row="1" Grid.Column="0" Margin="0,5,5,0" Fill="{StaticResource TextMuted}" RadiusX="3" RadiusY="3"/>
                <Rectangle Grid.Row="1" Grid.Column="1" Margin="5,5,0,0" Fill="{StaticResource TextMuted}" RadiusX="3" RadiusY="3"/>
              </Grid>
            </Border>
            <!-- Owned but not on the console yet. -->
            <TextBlock Text="&#xE753;" FontFamily="Segoe MDL2 Assets" FontSize="28" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Visibility="{x:Bind CloudShown}"/>
            <TextBlock Text="&#x2605;" FontSize="22" Foreground="{StaticResource Favourite}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0" Visibility="{x:Bind StarShown}"/>
            <Border x:Name="SelectionOutline" BorderBrush="{StaticResource TextPrimary}" BorderThickness="2" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <TextBlock Text="{x:Bind Title}" Width="{x:Bind TileWidth}" Margin="0,16,0,0" FontSize="{StaticResource BodySize}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
        </StackPanel>
      </Button>
    </DataTemplate>
    <!-- The shelf's containers carry no chrome of their own: the tile is
             the whole of the visible item, focus included. -->
    <Style x:Key="ShelfItemStyle" TargetType="ListViewItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="UseSystemFocusVisuals" Value="False"/>
      <Setter Property="VerticalContentAlignment" Value="Bottom"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListViewItem">
            <ContentPresenter VerticalAlignment="Bottom"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Page.Resources>
  <Grid Background="{StaticResource Screen}">
    <Viewbox Stretch="Uniform" StretchDirection="Both">
      <Grid Width="1920" Height="1080">
        <Grid.RowDefinitions>
          <RowDefinition Height="76"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="150"/>
        </Grid.RowDefinitions>
        <!-- The glow: an ellipse 1400 by 900, centred at seven tenths
                     across and fifteen hundredths down, which is where the
                     handoff puts it. It spans every row because it belongs to
                     the screen rather than to any one band of it, and it hit
                     tests nothing. -->
        <Rectangle Grid.Row="0" Grid.RowSpan="3" Width="1400" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="644,-288,0,0" Fill="{StaticResource ScreenGlow}" IsHitTestVisible="False"/>
        <!-- ================================================ status bar -->
        <Grid Grid.Row="0" Padding="56,0,56,0">
          <!-- Saying out loud what this console is running. It is the
                         quietest text on the screen on purpose: useful to know,
                         never the thing being read. -->
          <TextBlock x:Name="MachineText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{StaticResource BodySize}" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" CharacterSpacing="140"/>
          <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Right" VerticalAlignment="Center">
            <TextBlock x:Name="WifiGlyph" Text="&#xE701;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            <TextBlock x:Name="ClockText" FontSize="{StaticResource BodySize}" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>
        <!-- =================================================== content -->
        <Grid Grid.Row="1">
          <!-- Library. Vertically centred, because the shelf is the
                         only thing on it and a console screen should not make
                         the eye travel to find its one subject. -->
          <Grid x:Name="LibraryScreen" VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <!-- Sign-in and connection live here, top right, where
                             they can be noticed without being in the way. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="26" HorizontalAlignment="Right" Margin="0,0,56,34">
              <TextBlock x:Name="OfflineText" Text="Offline" FontSize="{StaticResource LabelSize}" FontWeight="Bold" Foreground="{StaticResource Warning}" VerticalAlignment="Center" Visibility="Collapsed"/>
              <HyperlinkButton x:Name="SignInLink" Padding="0" Click="OnSignInClicked">
                <TextBlock Text="Sign in to Steam &#x2192;" FontSize="{StaticResource LabelSize}" FontWeight="Bold" Foreground="{StaticResource Accent}" TextDecorations="None"/>
              </HyperlinkButton>
            </StackPanel>
            <ScrollViewer Grid.Row="1" IsTabStop="False" HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled" Padding="56,0,56,0">
              <ItemsControl x:Name="AppRail" ItemsSource="{x:Bind Tiles}" ItemTemplate="{StaticResource TileTemplate}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <!-- Emulators. Not games, so not on the shelf: this is
                         where they are set up, and where he decides which of
                         them is worth a place on the shelf at all. -->
          <Grid x:Name="EmulatorScreen" Visibility="Collapsed" Margin="56,40,56,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Systems" FontSize="{StaticResource SectionSize}" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,28"/>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
              <ItemsControl ItemsSource="{x:Bind Emulators}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <local:EvenWrapPanel Columns="4" Gap="26"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="local:Tile">
                    <Border Background="{StaticResource Surface}" CornerRadius="{StaticResource RadiusCard}" Padding="30">
                      <StackPanel>
                        <TextBlock Text="{x:Bind Title}" FontSize="{StaticResource ItemNameSize}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <TextBlock Text="{x:Bind Subtitle}" Margin="0,8,0,0" FontSize="{StaticResource LabelSize}" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                        <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,22,0,0">
                          <Button Content="Open" Style="{StaticResource ChipStyle}" FontSize="{StaticResource LabelSize}" Padding="20,10,20,10" Tag="{x:Bind}" Click="OnTileClicked"/>
                          <Button Content="{x:Bind ShelfAction}" Style="{StaticResource ChipStyle}" FontSize="{StaticResource LabelSize}" Padding="20,10,20,10" Tag="{x:Bind}" Click="OnShelfToggled"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
          <!-- The library with nothing in it. Not an error: a start. -->
          <StackPanel x:Name="EmptyScreen" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="Your library is empty" FontSize="{StaticResource DisplaySize}" FontWeight="Black" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
            <TextBlock Text="Sign in to a store, or add games you already have." Margin="0,20,0,0" FontSize="{StaticResource BodySize}" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,44,0,0" HorizontalAlignment="Center">
              <Button Content="Sign in to Steam" Style="{StaticResource PrimaryButtonStyle}" Click="OnSignInClicked"/>
              <Button Content="Add games" Style="{StaticResource ChipStyle}" FontSize="{StaticResource CtaSize}" Padding="46,22,46,22"/>
            </StackPanel>
          </StackPanel>
          <!-- Error is always the whole content area, never a line
                         tucked under something else: on a television, an
                         inline warning is a warning nobody reads. -->
          <Grid x:Name="ErrorScreen" Background="{StaticResource Screen}" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
              <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="72" Foreground="{StaticResource Danger}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ErrorTitle" Text="Something went wrong" Margin="0,28,0,0" FontSize="40" FontWeight="ExtraBold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center"/>
              <TextBlock x:Name="ErrorBody" MaxWidth="640" Margin="0,16,0,0" FontSize="{StaticResource ItemNameSmallSize}" Foreground="{StaticResource TextTertiary}" TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center"/>
              <Button Content="Try again" Margin="0,40,0,0" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" Click="OnRetryClicked"/>
            </StackPanel>
          </Grid>
        </Grid>
        <!-- ====================================================== dock -->
        <Grid Grid.Row="2" Background="{StaticResource Dock}" BorderBrush="{StaticResource DockEdge}" BorderThickness="0,1,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="22"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- The name of whatever has focus. Fixed height, so the
                         icons never move when it appears or empties. -->
          <TextBlock x:Name="NameText" Grid.Row="0" Margin="0,18,0,0" FontSize="{StaticResource LabelSize}" Foreground="{StaticResource TextTertiary}" HorizontalAlignment="Center"/>
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="30" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button x:Name="DockLibrary" Style="{StaticResource DockIconStyle}" Foreground="{StaticResource TextTertiary}" Tag="library" Click="OnDockClicked" PointerEntered="OnDockHover" GotFocus="OnDockHover" PointerExited="OnDockLeave" LostFocus="OnDockLeave">
              <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
            </Button>
            <Button x:Name="DockShop" Style="{StaticResource DockIconStyle}" Foreground="{StaticResource TextTertiary}" Tag="shop" Click="OnDockClicked" PointerEntered="OnDockHover" GotFocus="OnDockHover" PointerExited="OnDockLeave" LostFocus="OnDockLeave">
              <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
            </Button>
            <Button x:Name="DockEmulators" Style="{StaticResource DockIconStyle}" Foreground="{StaticResource TextTertiary}" Tag="emulators" Click="OnDockClicked" PointerEntered="OnDockHover" GotFocus="OnDockHover" PointerExited="OnDockLeave" LostFocus="OnDockLeave">
              <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
            </Button>
            <Button x:Name="DockFriends" Style="{StaticResource DockIconStyle}" Foreground="{StaticResource TextTertiary}" Tag="friends" Click="OnDockClicked" PointerEntered="OnDockHover" GotFocus="OnDockHover" PointerExited="OnDockLeave" LostFocus="OnDockLeave">
              <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
            </Button>
            <Button x:Name="DockMods" Style="{StaticResource DockIconStyle}" Foreground="{StaticResource TextTertiary}" Tag="mods" Click="OnDockClicked" PointerEntered="OnDockHover" GotFocus="OnDockHover" PointerExited="OnDockLeave" LostFocus="OnDockLeave">
              <TextBlock Text="&#xE90F;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
            </Button>
            <Button x:Name="DockDownloads" Style="{StaticResource DockIconStyle}" Foreground="{StaticResource TextTertiary}" Tag="downloads" Click="OnDockClicked" PointerEntered="OnDockHover" GotFocus="OnDockHover" PointerExited="OnDockLeave" LostFocus="OnDockLeave">
              <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="22"/>
            </Button>
          </StackPanel>
          <!-- The controllers in the room, and a way into their
                         screen. Bottom left, out of the path of the icons. -->
          <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="56,0,0,0">
            <Image Source="ms-appx:///Assets/controller-white.png" Width="48" Opacity="0.75"/>
            <TextBlock x:Name="CountText" FontSize="{StaticResource LabelSize}" FontWeight="Bold" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center"/>
            <!-- The charge, drawn rather than written: a cell with
                             a terminal reads at three metres, a bare
                             percentage does not. Shown only when there is one
                             pad, because with two the count is the useful
                             thing and there is no room for both. -->
            <StackPanel x:Name="BatteryBox" Visibility="Collapsed" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Viewbox Width="{StaticResource BatteryIconWidth}" Height="{StaticResource BatteryIconHeight}" Stretch="Uniform" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Border Width="62" Height="28" CornerRadius="5" BorderBrush="{StaticResource TextSecondary}" BorderThickness="2" Padding="3">
                    <Border x:Name="BatteryFill" Width="0" Height="16" HorizontalAlignment="Left" CornerRadius="2" Background="{StaticResource Accent}"/>
                  </Border>
                  <Border Width="5" Height="13" CornerRadius="0,2,2,0" VerticalAlignment="Center" Background="{StaticResource TextSecondary}"/>
                </StackPanel>
              </Viewbox>
              <TextBlock x:Name="BatteryText" FontSize="{StaticResource BodySize}" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
          <!-- What the app is doing, when it is doing something the
                         person should be able to see. -->
          <TextBlock x:Name="StatusText" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,56,0" FontSize="{StaticResource LabelSize}" Foreground="{StaticResource TextMuted}"/>
        </Grid>
      </Grid>
    </Viewbox>
    <!-- Where a PC game's frames land. This console's composition panel
             does not offer the interface that accepts a swap chain, and it
             will not hand over its own window either — measured, both — so the
             frames are copied back and shown as a picture, which is the one
             route that asks the platform for nothing. -->
    <Image x:Name="GameImage" Stretch="Fill" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <Border x:Name="GameLoading" Visibility="Collapsed" Background="{StaticResource DiagnosticBackground}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="700" Spacing="20">
        <ProgressRing x:Name="GameLoadingRing" Width="48" Height="48" IsActive="False" Foreground="{StaticResource Accent}"/>
        <TextBlock x:Name="GameLoadingText" FontSize="{StaticResource SectionSize}" Foreground="{StaticResource DiagnosticForeground}" TextAlignment="Center"/>
        <TextBlock x:Name="GameLoadingHint" FontSize="{StaticResource LabelSize}" Foreground="{StaticResource DiagnosticForeground}" TextWrapping="Wrap" TextAlignment="Center"/>
      </StackPanel>
    </Border>
    <!-- The credit, over the game as well as over the menu. It sits after
             the game's own image in the tree so the frames cannot cover it. -->
    <Border x:Name="GameCredit" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,26,0,0" Padding="26,10,26,10" CornerRadius="{StaticResource RadiusPill}" Background="#99000000" IsHitTestVisible="False">
      <TextBlock x:Name="GameCreditText" FontSize="{StaticResource LabelSize}" FontWeight="Bold" Foreground="{StaticResource TextSecondary}" CharacterSpacing="140"/>
    </Border>
    <Viewbox x:Name="GameDiagnostics" Visibility="Collapsed" Stretch="Uniform" IsHitTestVisible="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Grid Width="1920" Height="1080">
        <Path x:Name="GamePointer" HorizontalAlignment="Left" VerticalAlignment="Top" Data="M 0,0 L 0,30 L 8,23 L 14,36 L 20,33 L 14,21 L 25,21 Z" Fill="{StaticResource DiagnosticForeground}" Stroke="{StaticResource GameDetailBackground}" StrokeThickness="2">
          <Path.RenderTransform>
            <TranslateTransform x:Name="GamePointerTransform"/>
          </Path.RenderTransform>
        </Path>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,40,32" Padding="18,10" Background="{StaticResource DiagnosticBackground}" CornerRadius="{StaticResource RadiusCard}">
          <TextBlock x:Name="GameInputHint" FontSize="{StaticResource LabelSize}" Foreground="{StaticResource DiagnosticForeground}"/>
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,100,40,0" Padding="18,12" CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource DiagnosticBackground}" MaxWidth="720">
          <TextBlock x:Name="GameDiagnosticsText" Width="640" FontFamily="{StaticResource DiagnosticFontFamily}" FontSize="{StaticResource DiagnosticTextSize}" Foreground="{StaticResource DiagnosticForeground}" TextWrapping="Wrap"/>
        </Border>
      </Grid>
    </Viewbox>
  </Grid>
</Page>
