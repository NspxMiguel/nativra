<Page
    x:Class="Kiosk.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Kiosk"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    KeyDown="OnKeyDown"
    Background="#FF000000">

    <Page.Resources>
        <DataTemplate x:Key="TileTemplate" x:DataType="local:Tile">
            <Grid Width="280" Height="200" Margin="0,0,24,24">
                <Border CornerRadius="14" Background="#FF121214"
                        BorderBrush="#22FFFFFF" BorderThickness="1" />
                <Border CornerRadius="14" Background="{x:Bind Accent}" Opacity="0.14" />
                <StackPanel Margin="24" VerticalAlignment="Bottom">
                    <Border Width="52" Height="52" CornerRadius="12" Background="{x:Bind Accent}"
                            HorizontalAlignment="Left" Margin="0,0,0,16">
                        <TextBlock Text="{x:Bind Initial}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="#FFFFFFFF" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{x:Bind Title}" FontSize="21" FontWeight="SemiBold"
                               Foreground="#FFF5F5F7" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind Subtitle}" FontSize="15" Foreground="#99F5F5F7"
                               TextTrimming="CharacterEllipsis" MaxLines="1" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <!-- 64/48 gutter keeps everything inside the TV-safe area on a 1080p set. -->
    <Grid Padding="64,48,64,48">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,32">
            <TextBlock Text="KIOSK" FontSize="15" FontWeight="SemiBold" Foreground="#FF6B4CE6"
                       CharacterSpacing="180" />
            <TextBlock Text="Everything installed on this console"
                       FontSize="34" FontWeight="SemiBold" Foreground="#FFF5F5F7" Margin="0,6,0,0" />
        </StackPanel>

        <GridView x:Name="AppGrid" Grid.Row="1"
                  ItemsSource="{x:Bind Tiles}"
                  ItemTemplate="{StaticResource TileTemplate}"
                  IsItemClickEnabled="True"
                  ItemClick="OnTileInvoked"
                  SelectionMode="Single"
                  ScrollViewer.HorizontalScrollMode="Disabled"
                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                  Padding="0,0,0,24" />

        <TextBlock x:Name="StatusText" Grid.Row="2" Text="" FontSize="16"
                   Foreground="#80F5F5F7" Margin="0,16,0,0" />
    </Grid>
</Page>
